</span></span><span>PORT=5000
</span><span># MONGO_URI=mongodb://localhost:27017/portfolio_db
</span><span>NODE_ENV=development
</span><span>MONGODB_URI=mongodb+srv://hariharanv001_db_useddddr:KecJxzOZYWI6ksac@cluster0.iidekar.mongodb.net/portfolio_db
</span><span>//serever.js
</span><span>const express = require('express');
</span><span>const dotenv   = require('dotenv');
</span><span>const cors     = require('cors');
</span><span>const connectDB     = require('./config/db');
</span><span>const errorHandler  = require('./middleware/errorHandler');
</span><span>
</span><span>// Load env variables
</span><span>dotenv.config();
</span><span>
</span><span>// Connect to MongoDB
</span><span>connectDB();
</span><span>
</span><span>const app = express();
</span><span>
</span><span>// ─── Middleware ───────────────────────────────
</span><span>app.use(cors());                        // Allow frontend to call API
</span><span>app.use(express.json());                // Parse JSON request body
</span><span>app.use(express.urlencoded({ extended: false })); // Parse form data
</span><span>
</span><span>// ─── Routes ──────────────────────────────────
</span><span>app.use('/api/contacts', require('./routes/contactRoutes'));
</span><span>app.use('/api/projects', require('./routes/projectRoutes'));
</span><span>app.use('/api/skills',   require('./routes/skillRoutes'));
</span><span>app.use('/api/profile',  require('./routes/profileRoutes'));
</span><span>app.use('/api/about-me',  require('./routes/Aboutmeroutes')); 
</span><span>app.use('/api/skills',    require('./routes/skillRoutes'));
</span><span>
</span><span>
</span><span>// ─── Health check ────────────────────────────
</span><span>app.get('/', (req, res) =&gt; {
</span><span>  res.json({ message: '✅ Portfolio API is running' });
</span><span>});
</span><span>
</span><span>// ─── Global error handler (must be last) ─────
</span><span>app.use(errorHandler);
</span><span>
</span><span>// ─── Start Server ────────────────────────────
</span><span>const PORT = process.env.PORT || 5000;
</span><span>app.listen(PORT, () =&gt; {
</span><span>  console.log(`🚀 Server running at http://localhost:${PORT}`);
</span><span>});</span></code></pre></div></div><div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-bg-300 to-transparent pointer-events-none"></div></div><button class="pb-3 pt-1 text-xs text-text-500/80 hover:text-text-100 transition w-3/4 text-left rounded-lg">Show more</button></div></div></div><div class="flex justify-start opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition" role="group" aria-label="Message actions"><div class="text-text-300"><div class="text-text-300 flex items-stretch justify-between"><span class="text-text-500 text-xs flex items-center mr-2" data-state="closed">3:48 PM</span><div class="flex items-center"><div class="w-fit" data-state="closed"><button class="inline-flex
